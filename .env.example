# Copy to .env (root). Used by docker-compose.yml, apps/api and apps/web.
# Development-only values. Never put production secrets here.

NODE_ENV=development
LOG_LEVEL=debug

# --- Apps ---
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=ml
POSTGRES_PASSWORD=ml
POSTGRES_DB=ml
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ml:ml@localhost:5432/ml?schema=public
DATABASE_URL_TEST=postgresql://ml:ml@localhost:5432/ml_test?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Meilisearch (UI: http://localhost:7700) ---
MEILI_PORT=7700
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me-0123456789

# --- S3 / MinIO (console: http://localhost:9001, login = access key / secret) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin-dev-secret
S3_BUCKET_MEDIA=ml-media
S3_BUCKET_PRIVATE=ml-private
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/ml-media

# --- Email / Mailpit (UI: http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM="Мисливська лавка <no-reply@localhost>"
