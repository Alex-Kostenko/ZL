{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1": {
      "get": {
        "operationId": "App_getRoot",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInfoDto"
                }
              }
            }
          },
          "default": {
            "description": "Error (unified format, see `code`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "API info",
        "tags": [
          "system"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "Health_liveness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessDto"
                }
              }
            }
          },
          "default": {
            "description": "Error (unified format, see `code`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Liveness: the process is up (no dependency checks)",
        "tags": [
          "system"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "Health_readiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessDto"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessDto"
                }
              }
            }
          },
          "default": {
            "description": "Error (unified format, see `code`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Readiness: PostgreSQL, Redis, Meilisearch reachable",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/categories": {
      "get": {
        "operationId": "Categories_getTree",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Used when `locale` is absent",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "Response language (`uk`, `ru`, `en`). Unsupported → `Accept-Language` → `uk`.",
            "schema": {
              "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})?$",
              "example": "ru",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryTreeDto"
                }
              }
            }
          },
          "default": {
            "description": "Error (unified format, see `code`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Active category tree (menu, sitemap)",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/categories/by-path": {
      "get": {
        "operationId": "Categories_getByPath",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Used when `locale` is absent",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "Response language (`uk`, `ru`, `en`). Unsupported → `Accept-Language` → `uk`.",
            "schema": {
              "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})?$",
              "example": "ru",
              "type": "string"
            }
          },
          {
            "name": "path",
            "required": true,
            "in": "query",
            "description": "Slug path without leading/trailing slashes.",
            "schema": {
              "maxLength": 1000,
              "pattern": "^[a-z0-9-]+(\\/[a-z0-9-]+)*$",
              "example": "zbroia/vohnepalna-zbroia",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryDetailDto"
                }
              }
            }
          },
          "default": {
            "description": "Error (unified format, see `code`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Category page by slug path, with breadcrumbs and subcategories",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/products": {
      "get": {
        "operationId": "Products_list",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Used when `locale` is absent",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "Response language (`uk`, `ru`, `en`). Unsupported → `Accept-Language` → `uk`.",
            "schema": {
              "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})?$",
              "example": "ru",
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": true,
            "in": "query",
            "description": "1-based page number.",
            "schema": {
              "minimum": 1,
              "maximum": 10000,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "description": "Page size.",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 24,
              "type": "number"
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Category slug path; includes products of all its subcategories.",
            "schema": {
              "maxLength": 1000,
              "pattern": "^[a-z0-9-]+(\\/[a-z0-9-]+)*$",
              "example": "zbroia/vohnepalna-zbroia",
              "type": "string"
            }
          },
          {
            "name": "brand",
            "required": false,
            "in": "query",
            "description": "Brand slug.",
            "schema": {
              "maxLength": 200,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductListDto"
                }
              }
            }
          },
          "default": {
            "description": "Error (unified format, see `code`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Published products, newest first, by category subtree and/or brand",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/products/{slug}": {
      "get": {
        "operationId": "Products_bySlug",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Used when `locale` is absent",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          },
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "Response language (`uk`, `ru`, `en`). Unsupported → `Accept-Language` → `uk`.",
            "schema": {
              "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})?$",
              "example": "ru",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDetailDto"
                }
              }
            }
          },
          "default": {
            "description": "Error (unified format, see `code`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Product page: variants, characteristics, gallery, price, stock",
        "tags": [
          "catalog"
        ]
      }
    }
  },
  "info": {
    "title": "Мисливська лавка API",
    "description": "REST API `/api/v1`: storefront, admin, integrations.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "AppInfoDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Service name."
          },
          "status": {
            "type": "string",
            "description": "Always `ok` when the API is reachable."
          }
        },
        "required": [
          "name",
          "status"
        ]
      },
      "LivenessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` while the process serves HTTP.",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "DependencyCheckDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "latencyMs": {
            "type": "number",
            "description": "Round-trip time of the check."
          },
          "error": {
            "type": "string",
            "description": "Short reason when down (`timeout`, `unreachable`); never contains hosts or credentials."
          }
        },
        "required": [
          "status",
          "latencyMs"
        ]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DependencyCheckDto"
          },
          "redis": {
            "$ref": "#/components/schemas/DependencyCheckDto"
          },
          "search": {
            "$ref": "#/components/schemas/DependencyCheckDto"
          }
        },
        "required": [
          "database",
          "redis",
          "search"
        ]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "status": {
            "description": "`ok` only if every dependency is up; otherwise HTTP 503.",
            "enum": [
              "ok",
              "error"
            ],
            "type": "string"
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "CategoryImageDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "width": {
            "type": "number",
            "nullable": true
          },
          "height": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "url",
          "width",
          "height"
        ]
      },
      "CategoryNodeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Full slug path, e.g. `zbroia/vohnepalna-zbroia`; the storefront URL is `/category/{path}`."
          },
          "depth": {
            "type": "number",
            "description": "0 for root categories."
          },
          "name": {
            "type": "string",
            "description": "Name in the response locale (falls back to `uk`)."
          },
          "icon": {
            "type": "string",
            "nullable": true,
            "description": "Lucide icon name for menus."
          },
          "image": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryImageDto"
              }
            ]
          },
          "children": {
            "description": "Active subcategories in menu order.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryNodeDto"
            }
          }
        },
        "required": [
          "id",
          "slug",
          "path",
          "depth",
          "name",
          "icon",
          "image",
          "children"
        ]
      },
      "CategoryTreeDto": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "description": "Locale the names are in."
          },
          "items": {
            "description": "Active root categories with their active descendants.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryNodeDto"
            }
          }
        },
        "required": [
          "locale",
          "items"
        ]
      },
      "BreadcrumbDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "path"
        ]
      },
      "CategorySummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryImageDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "path",
          "name",
          "icon",
          "image"
        ]
      },
      "CategoryDetailDto": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "depth": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryImageDto"
              }
            ]
          },
          "breadcrumbs": {
            "description": "Root → this category (inclusive).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BreadcrumbDto"
            }
          },
          "children": {
            "description": "Direct active subcategories.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategorySummaryDto"
            }
          }
        },
        "required": [
          "locale",
          "id",
          "slug",
          "path",
          "depth",
          "name",
          "description",
          "icon",
          "image",
          "breadcrumbs",
          "children"
        ]
      },
      "ProductBrandDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ]
      },
      "ProductImageDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "width": {
            "type": "number",
            "nullable": true
          },
          "height": {
            "type": "number",
            "nullable": true
          },
          "alt": {
            "type": "string",
            "description": "Alt text in the response locale; the product title when none is set."
          },
          "variantId": {
            "type": "string",
            "nullable": true,
            "description": "Set when the image shows one variant (e.g. a colour)."
          }
        },
        "required": [
          "url",
          "width",
          "height",
          "alt",
          "variantId"
        ]
      },
      "PriceDto": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "description": "ISO 4217, e.g. `UAH`."
          },
          "amount": {
            "type": "string",
            "description": "Selling price (`salePrice ?? price`).",
            "example": "1299.00"
          },
          "oldAmount": {
            "type": "string",
            "nullable": true,
            "description": "Crossed-out reference price; present only when greater than `amount`.",
            "example": 1599
          },
          "discountPercent": {
            "type": "number",
            "nullable": true,
            "description": "Whole-percent discount from `oldAmount`, e.g. 19."
          }
        },
        "required": [
          "currency",
          "amount",
          "oldAmount",
          "discountPercent"
        ]
      },
      "ProductListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "brand": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProductBrandDto"
              }
            ]
          },
          "image": {
            "nullable": true,
            "description": "Primary image (or the first one).",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProductImageDto"
              }
            ]
          },
          "price": {
            "nullable": true,
            "description": "Lowest current price among active variants; `null` when none is priced.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PriceDto"
              }
            ]
          },
          "hasPriceRange": {
            "type": "boolean",
            "description": "Variants differ in price: show the price as \"from\"."
          },
          "available": {
            "type": "number",
            "description": "Sum over active variants and active warehouses."
          },
          "inStock": {
            "type": "boolean"
          },
          "isSale": {
            "type": "boolean"
          },
          "isAntidron": {
            "type": "boolean"
          },
          "variantCount": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "slug",
          "sku",
          "title",
          "brand",
          "image",
          "price",
          "hasPriceRange",
          "available",
          "inStock",
          "isSale",
          "isAntidron",
          "variantCount"
        ]
      },
      "ProductListDto": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductListItemDto"
            }
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "locale",
          "items",
          "page",
          "limit",
          "total",
          "totalPages"
        ]
      },
      "ProductCategoryRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "name"
        ]
      },
      "AttributeValueDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Display text in the response locale, e.g. `12 кал.`, `3–9`, `Так`. Units are separate."
          },
          "code": {
            "type": "string",
            "nullable": true,
            "description": "Option code for SELECT / MULTI_SELECT (used in filter URLs)."
          }
        },
        "required": [
          "text",
          "code"
        ]
      },
      "ProductAttributeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "nullable": true,
            "description": "Localized unit, e.g. `мм`."
          },
          "type": {
            "type": "string",
            "description": "STRING, NUMBER, BOOLEAN, SELECT, MULTI_SELECT or RANGE."
          },
          "values": {
            "description": "Several only for MULTI_SELECT.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttributeValueDto"
            }
          }
        },
        "required": [
          "code",
          "name",
          "unit",
          "type",
          "values"
        ]
      },
      "WarehouseStockDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "available": {
            "type": "number",
            "description": "Units available for sale in this warehouse (never negative)."
          }
        },
        "required": [
          "code",
          "name",
          "available"
        ]
      },
      "StockDto": {
        "type": "object",
        "properties": {
          "available": {
            "type": "number",
            "description": "Units available for sale across active warehouses (never negative)."
          },
          "inStock": {
            "type": "boolean"
          },
          "warehouses": {
            "description": "Active warehouses with stock, in display order.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WarehouseStockDto"
            }
          }
        },
        "required": [
          "available",
          "inStock",
          "warehouses"
        ]
      },
      "ProductVariantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "barcode": {
            "type": "string",
            "nullable": true
          },
          "options": {
            "description": "Variant-distinguishing characteristics (calibre, size, colour).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductAttributeDto"
            }
          },
          "price": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PriceDto"
              }
            ]
          },
          "stock": {
            "$ref": "#/components/schemas/StockDto"
          }
        },
        "required": [
          "id",
          "sku",
          "barcode",
          "options",
          "price",
          "stock"
        ]
      },
      "ProductDetailDto": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "shortDescription": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "brand": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProductBrandDto"
              }
            ]
          },
          "category": {
            "nullable": true,
            "description": "Primary category (canonical URL, breadcrumbs); `null` when it is hidden.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProductCategoryRefDto"
              }
            ]
          },
          "breadcrumbs": {
            "description": "Root → primary category.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BreadcrumbDto"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductImageDto"
            }
          },
          "attributes": {
            "description": "Product-level characteristics, in display order.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductAttributeDto"
            }
          },
          "variants": {
            "description": "Active variants, in display order.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductVariantDto"
            }
          },
          "price": {
            "nullable": true,
            "description": "Lowest current variant price.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PriceDto"
              }
            ]
          },
          "hasPriceRange": {
            "type": "boolean"
          },
          "stock": {
            "description": "Sum over active variants.",
            "allOf": [
              {
                "$ref": "#/components/schemas/StockDto"
              }
            ]
          },
          "isSale": {
            "type": "boolean"
          },
          "isAntidron": {
            "type": "boolean"
          },
          "publishedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "locale",
          "id",
          "slug",
          "sku",
          "title",
          "shortDescription",
          "description",
          "brand",
          "category",
          "breadcrumbs",
          "images",
          "attributes",
          "variants",
          "price",
          "hasPriceRange",
          "stock",
          "isSale",
          "isAntidron",
          "publishedAt"
        ]
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Dot path of the invalid field, e.g. `address.city` or `items.0.qty`."
          },
          "messages": {
            "description": "Human-readable problems with this field.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "messages"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "description": "HTTP status code."
          },
          "code": {
            "type": "string",
            "description": "Machine-readable code, e.g. `VALIDATION_FAILED`, `NOT_FOUND`."
          },
          "message": {
            "type": "string",
            "description": "Human-readable summary; safe to show, never contains internals."
          },
          "requestId": {
            "type": "string",
            "description": "Correlates with server logs and the `X-Request-Id` header."
          },
          "details": {
            "description": "Per-field problems (validation errors).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetailDto"
            }
          }
        },
        "required": [
          "statusCode",
          "code",
          "message",
          "requestId"
        ]
      }
    }
  }
}
