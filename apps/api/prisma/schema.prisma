// Single source of truth for the DB schema (§33). Change only via `npm run db:migrate`.
// Model conventions: .claude/rules/prisma.md; table list: .claude/docs/spec/infra.md §32.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Key-value store for admin Settings (§13, permission `settings.manage`); typed per key in the service.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("settings")
}

// ─── Localization (§59) ──────────────────────────────────────────────────────
// Every translatable entity has a `<entity>_translations` table keyed by (entityId, locale).
// Locales are rows, not an enum: adding a language never changes the schema.

/// Supported content languages. Seeded by migration: uk (default), ru, en.
model Locale {
  /// BCP 47 code, e.g. `uk`.
  code      String  @id @db.VarChar(10)
  name      String
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")
  position  Int     @default(0)

  categoryTranslations CategoryTranslation[]
  brandTranslations    BrandTranslation[]
  productTranslations  ProductTranslation[]

  @@map("locales")
}

// ─── Catalog: categories (§5) ────────────────────────────────────────────────

/// Unlimited-depth tree: adjacency list (`parentId`) + materialized `path` for URL lookup and
/// breadcrumbs. `slug` is unique among siblings; `path` (slugs joined by `/`) is globally unique.
/// `path`/`depth` of the subtree are maintained by the catalog service when a category moves.
model Category {
  id         String   @id @default(uuid(7)) @db.Uuid
  parentId   String?  @map("parent_id") @db.Uuid
  slug       String   @db.VarChar(200)
  /// e.g. `zbroia/vohnepalna-zbroia/rushnytsi`; resolves `/category/[...slug]` in one query.
  path       String   @unique @db.VarChar(1000)
  depth      Int      @default(0)
  /// Menu icon identifier (Lucide name), not a file.
  icon       String?  @db.VarChar(100)
  position   Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  canonical  String?  @db.VarChar(1000)
  /// Tria id, when the category comes from the ERP.
  externalId String?  @unique @map("external_id") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     ProductCategory[]
  primaryFor   Product[]             @relation("ProductPrimaryCategory")

  @@index([parentId, position])
  @@map("categories")
}

model CategoryTranslation {
  categoryId     String  @map("category_id") @db.Uuid
  locale         String  @db.VarChar(10)
  name           String  @db.VarChar(255)
  description    String?
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(500)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language Locale   @relation(fields: [locale], references: [code], onDelete: Restrict)

  @@id([categoryId, locale])
  @@index([locale])
  @@map("category_translations")
}

// ─── Catalog: brands (§9) ────────────────────────────────────────────────────

/// Brand name is a proper noun and is not translated; description and SEO texts are.
model Brand {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String   @db.VarChar(255)
  slug       String   @unique @db.VarChar(200)
  /// ISO 3166-1 alpha-2, e.g. `UA`, `US`.
  country    String?  @db.Char(2)
  website    String?  @db.VarChar(500)
  isActive   Boolean  @default(true) @map("is_active")
  externalId String?  @unique @map("external_id") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  translations BrandTranslation[]
  products     Product[]

  @@index([isActive, name])
  @@map("brands")
}

model BrandTranslation {
  brandId        String  @map("brand_id") @db.Uuid
  locale         String  @db.VarChar(10)
  description    String?
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(500)

  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  language Locale @relation(fields: [locale], references: [code], onDelete: Restrict)

  @@id([brandId, locale])
  @@index([locale])
  @@map("brand_translations")
}

// ─── Catalog: products and variants (§6, §7) ─────────────────────────────────

/// Admin lifecycle. Storefront visibility is `isPublished`, not the status.
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum VariantStatus {
  ACTIVE
  INACTIVE

  @@map("variant_status")
}

/// Sellable model. Every product has at least one variant (a simple product has exactly one);
/// prices and stock belong to variants (§10, §11). `isSale`/`isAntidron` are product flags that
/// drive /sale and /antidron, never categories (§6).
model Product {
  id                String        @id @default(uuid(7)) @db.Uuid
  sku               String        @unique @db.VarChar(100)
  slug              String        @unique @db.VarChar(255)
  brandId           String?       @map("brand_id") @db.Uuid
  /// Drives canonical URL and breadcrumbs; must also be one of `categories`.
  primaryCategoryId String?       @map("primary_category_id") @db.Uuid
  status            ProductStatus @default(DRAFT)
  isPublished       Boolean       @default(false) @map("is_published")
  publishedAt       DateTime?     @map("published_at")
  isSale            Boolean       @default(false) @map("is_sale")
  isAntidron        Boolean       @default(false) @map("is_antidron")
  externalId        String?       @unique @map("external_id") @db.VarChar(100)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  brand           Brand?               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  primaryCategory Category?            @relation("ProductPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  categories      ProductCategory[]
  variants        ProductVariant[]
  translations    ProductTranslation[]

  @@index([brandId])
  @@index([primaryCategoryId])
  @@index([status, updatedAt])
  @@index([isPublished, isSale])
  @@index([isPublished, isAntidron])
  @@map("products")
}

model ProductTranslation {
  productId        String  @map("product_id") @db.Uuid
  locale           String  @db.VarChar(10)
  title            String  @db.VarChar(500)
  shortDescription String? @map("short_description")
  description      String?

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  language Locale  @relation(fields: [locale], references: [code], onDelete: Restrict)

  @@id([productId, locale])
  @@index([locale])
  @@map("product_translations")
}

/// Product ↔ category (many-to-many). `position` = manual order of the product inside the category.
model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  position   Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, position])
  @@map("product_categories")
}

/// Concrete purchasable item (calibre, size, colour… via attributes in 5.3). No price/stock here.
model ProductVariant {
  id         String        @id @default(uuid(7)) @db.Uuid
  productId  String        @map("product_id") @db.Uuid
  sku        String        @unique @db.VarChar(100)
  barcode    String?       @db.VarChar(50)
  weightG    Int?          @map("weight_g")
  lengthMm   Int?          @map("length_mm")
  widthMm    Int?          @map("width_mm")
  heightMm   Int?          @map("height_mm")
  status     VariantStatus @default(ACTIVE)
  position   Int           @default(0)
  externalId String?       @unique @map("external_id") @db.VarChar(100)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@index([barcode])
  @@map("product_variants")
}
