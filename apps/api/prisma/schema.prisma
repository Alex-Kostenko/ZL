// Single source of truth for the DB schema (§33). Change only via `npm run db:migrate`.
// Model conventions: .claude/rules/prisma.md; table list: .claude/docs/spec/infra.md §32.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Key-value store for admin Settings (§13, permission `settings.manage`); typed per key in the service.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("settings")
}

// ─── Localization (§59) ──────────────────────────────────────────────────────
// Every translatable entity has a `<entity>_translations` table keyed by (entityId, locale).
// Locales are rows, not an enum: adding a language never changes the schema.

/// Supported content languages. Seeded by migration: uk (default), ru, en.
model Locale {
  /// BCP 47 code, e.g. `uk`.
  code      String  @id @db.VarChar(10)
  name      String
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")
  position  Int     @default(0)

  categoryTranslations       CategoryTranslation[]
  brandTranslations          BrandTranslation[]
  productTranslations        ProductTranslation[]
  attributeTranslations      AttributeTranslation[]
  attributeValueTranslations AttributeValueTranslation[]
  mediaTranslations          MediaTranslation[]
  seoMetadata                SeoMetadata[]

  @@map("locales")
}

// ─── Catalog: categories (§5) ────────────────────────────────────────────────

/// Unlimited-depth tree: adjacency list (`parentId`) + materialized `path` for URL lookup and
/// breadcrumbs. `slug` is unique among siblings; `path` (slugs joined by `/`) is globally unique.
/// `path`/`depth` of the subtree are maintained by the catalog service when a category moves.
model Category {
  id         String   @id @default(uuid(7)) @db.Uuid
  parentId   String?  @map("parent_id") @db.Uuid
  slug       String   @db.VarChar(200)
  /// e.g. `zbroia/vohnepalna-zbroia/rushnytsi`; resolves `/category/[...slug]` in one query.
  path       String   @unique @db.VarChar(1000)
  depth      Int      @default(0)
  /// Menu icon identifier (Lucide name), not a file.
  icon       String?  @db.VarChar(100)
  imageId    String?  @map("image_id") @db.Uuid
  position   Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  /// Tria id, when the category comes from the ERP.
  externalId String?  @unique @map("external_id") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     ProductCategory[]
  primaryFor   Product[]             @relation("ProductPrimaryCategory")
  attributes   CategoryAttribute[]
  image        Media?                @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)

  @@index([parentId, position])
  @@map("categories")
}

model CategoryTranslation {
  categoryId  String  @map("category_id") @db.Uuid
  locale      String  @db.VarChar(10)
  name        String  @db.VarChar(255)
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language Locale   @relation(fields: [locale], references: [code], onDelete: Restrict)

  @@id([categoryId, locale])
  @@index([locale])
  @@map("category_translations")
}

// ─── Catalog: brands (§9) ────────────────────────────────────────────────────

/// Brand name is a proper noun and is not translated; description and SEO texts are.
model Brand {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String   @db.VarChar(255)
  slug       String   @unique @db.VarChar(200)
  /// ISO 3166-1 alpha-2, e.g. `UA`, `US`.
  country    String?  @db.Char(2)
  website    String?  @db.VarChar(500)
  logoId     String?  @map("logo_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  externalId String?  @unique @map("external_id") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  translations BrandTranslation[]
  products     Product[]
  logo         Media?             @relation("BrandLogo", fields: [logoId], references: [id], onDelete: SetNull)

  @@index([isActive, name])
  @@map("brands")
}

model BrandTranslation {
  brandId     String  @map("brand_id") @db.Uuid
  locale      String  @db.VarChar(10)
  description String?

  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  language Locale @relation(fields: [locale], references: [code], onDelete: Restrict)

  @@id([brandId, locale])
  @@index([locale])
  @@map("brand_translations")
}

// ─── Catalog: products and variants (§6, §7) ─────────────────────────────────

/// Admin lifecycle. Storefront visibility is `isPublished`, not the status.
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum VariantStatus {
  ACTIVE
  INACTIVE

  @@map("variant_status")
}

/// Sellable model. Every product has at least one variant (a simple product has exactly one);
/// prices and stock belong to variants (§10, §11). `isSale`/`isAntidron` are product flags that
/// drive /sale and /antidron, never categories (§6).
model Product {
  id                String        @id @default(uuid(7)) @db.Uuid
  sku               String        @unique @db.VarChar(100)
  slug              String        @unique @db.VarChar(255)
  brandId           String?       @map("brand_id") @db.Uuid
  /// Drives canonical URL and breadcrumbs; must also be one of `categories`.
  primaryCategoryId String?       @map("primary_category_id") @db.Uuid
  status            ProductStatus @default(DRAFT)
  isPublished       Boolean       @default(false) @map("is_published")
  publishedAt       DateTime?     @map("published_at")
  isSale            Boolean       @default(false) @map("is_sale")
  isAntidron        Boolean       @default(false) @map("is_antidron")
  externalId        String?       @unique @map("external_id") @db.VarChar(100)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  brand           Brand?                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  primaryCategory Category?               @relation("ProductPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  categories      ProductCategory[]
  variants        ProductVariant[]
  translations    ProductTranslation[]
  attributeValues ProductAttributeValue[]
  media           ProductMedia[]

  @@index([brandId])
  @@index([primaryCategoryId])
  @@index([status, updatedAt])
  @@index([isPublished, isSale])
  @@index([isPublished, isAntidron])
  @@map("products")
}

model ProductTranslation {
  productId        String  @map("product_id") @db.Uuid
  locale           String  @db.VarChar(10)
  title            String  @db.VarChar(500)
  shortDescription String? @map("short_description")
  description      String?

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  language Locale  @relation(fields: [locale], references: [code], onDelete: Restrict)

  @@id([productId, locale])
  @@index([locale])
  @@map("product_translations")
}

/// Product ↔ category (many-to-many). `position` = manual order of the product inside the category.
model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  position   Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, position])
  @@map("product_categories")
}

/// Concrete purchasable item (calibre, size, colour… via attributes in 5.3). No price/stock here.
model ProductVariant {
  id         String        @id @default(uuid(7)) @db.Uuid
  productId  String        @map("product_id") @db.Uuid
  sku        String        @unique @db.VarChar(100)
  barcode    String?       @db.VarChar(50)
  weightG    Int?          @map("weight_g")
  lengthMm   Int?          @map("length_mm")
  widthMm    Int?          @map("width_mm")
  heightMm   Int?          @map("height_mm")
  status     VariantStatus @default(ACTIVE)
  position   Int           @default(0)
  externalId String?       @unique @map("external_id") @db.VarChar(100)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues ProductAttributeValue[]
  inventory       Inventory[]
  prices          Price[]
  media           ProductMedia[]

  @@index([productId, position])
  @@index([barcode])
  @@map("product_variants")
}

// ─── Catalog: attributes (§8, provenance §67.10) ─────────────────────────────
// Normalized characteristics, never a JSON column on Product. Human-language values are
// SELECT/MULTI_SELECT options with translated labels; STRING is for language-neutral text
// (model numbers, standards). One source of truth per fact, so every page shows the same value.

enum AttributeType {
  STRING
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  /// Numeric interval, e.g. magnification 3–9×: `value_number`..`value_number_to`.
  RANGE

  @@map("attribute_type")
}

/// Where a characteristic value came from (§67.10).
enum AttributeSource {
  MANUAL
  TRIA
  SUPPLIER_FEED
  IMPORT

  @@map("attribute_source")
}

model Attribute {
  id              String        @id @default(uuid(7)) @db.Uuid
  /// Stable machine key used in filters and imports, e.g. `caliber`, `blade_length`.
  code            String        @unique @db.VarChar(100)
  type            AttributeType
  isFilterable    Boolean       @default(false) @map("is_filterable")
  isSearchable    Boolean       @default(false) @map("is_searchable")
  /// Distinguishes variants of one product (calibre, size, colour).
  isVariantOption Boolean       @default(false) @map("is_variant_option")
  position        Int           @default(0)
  externalId      String?       @unique @map("external_id") @db.VarChar(100)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  translations  AttributeTranslation[]
  values        AttributeValue[]
  categories    CategoryAttribute[]
  productValues ProductAttributeValue[]

  @@map("attributes")
}

model AttributeTranslation {
  attributeId String  @map("attribute_id") @db.Uuid
  locale      String  @db.VarChar(10)
  name        String  @db.VarChar(255)
  /// Localized unit, e.g. `мм` / `mm`.
  unit        String? @db.VarChar(50)

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  language  Locale    @relation(fields: [locale], references: [code], onDelete: Restrict)

  @@id([attributeId, locale])
  @@map("attribute_translations")
}

/// Predefined option of a SELECT / MULTI_SELECT attribute.
model AttributeValue {
  id          String   @id @default(uuid(7)) @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  /// URL-safe key used in filter URLs, e.g. `12-kalibr`; unique within the attribute.
  code        String   @db.VarChar(150)
  position    Int      @default(0)
  externalId  String?  @unique @map("external_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  attribute     Attribute                   @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  translations  AttributeValueTranslation[]
  productValues ProductAttributeValue[]

  @@unique([attributeId, code])
  @@index([attributeId, position])
  @@map("attribute_values")
}

model AttributeValueTranslation {
  attributeValueId String @map("attribute_value_id") @db.Uuid
  locale           String @db.VarChar(10)
  label            String @db.VarChar(255)

  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  language       Locale         @relation(fields: [locale], references: [code], onDelete: Restrict)

  @@id([attributeValueId, locale])
  @@map("attribute_value_translations")
}

/// Attributes available in a category (§8). Subcategories inherit their ancestors' attributes
/// (resolved by the catalog service along `categories.path`).
model CategoryAttribute {
  categoryId   String  @map("category_id") @db.Uuid
  attributeId  String  @map("attribute_id") @db.Uuid
  position     Int     @default(0)
  isRequired   Boolean @default(false) @map("is_required")
  /// Show as a facet on this category page.
  isFilterable Boolean @default(true) @map("is_filterable")

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@id([categoryId, attributeId])
  @@index([attributeId])
  @@map("category_attributes")
}

/// One characteristic value of a product (variantId = null) or of a single variant.
/// Exactly one value column is used, matching `attributes.type`; MULTI_SELECT = one row per option.
/// The catalog service validates type consistency and uniqueness per (product, variant, attribute).
model ProductAttributeValue {
  id            String   @id @default(uuid(7)) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  variantId     String?  @map("variant_id") @db.Uuid
  attributeId   String   @map("attribute_id") @db.Uuid
  /// SELECT / MULTI_SELECT.
  valueId       String?  @map("value_id") @db.Uuid
  /// NUMBER, and the lower bound of RANGE.
  valueNumber   Decimal? @map("value_number") @db.Decimal(14, 4)
  /// Upper bound of RANGE.
  valueNumberTo Decimal? @map("value_number_to") @db.Decimal(14, 4)
  valueBoolean  Boolean? @map("value_boolean")
  /// STRING (language-neutral).
  valueText     String?  @map("value_text") @db.VarChar(1000)

  // Provenance (§67.10).
  source           AttributeSource @default(MANUAL)
  sourceExternalId String?         @map("source_external_id") @db.VarChar(100)
  sourceUpdatedAt  DateTime?       @map("source_updated_at")
  verifiedAt       DateTime?       @map("verified_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute Attribute       @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  value     AttributeValue? @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@index([productId, attributeId])
  @@index([variantId])
  @@index([attributeId, valueId])
  @@index([attributeId, valueNumber])
  @@map("product_attribute_values")
}

// ─── Inventory (§11) ─────────────────────────────────────────────────────────
// Stock lives per variant × warehouse; there is no global product.stock.

model Warehouse {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Short stable key, e.g. `kyiv-main`.
  code       String   @unique @db.VarChar(50)
  name       String   @db.VarChar(255)
  isActive   Boolean  @default(true) @map("is_active")
  position   Int      @default(0)
  externalId String?  @unique @map("external_id") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  inventory Inventory[]

  @@map("warehouses")
}

/// `available` is a stored generated column (quantity - reserved), computed by PostgreSQL:
/// never write it. It can be negative when Tria lowers quantity below open reservations;
/// InventoryService treats that as 0 for sale.
model Inventory {
  variantId   String   @map("variant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  available   Int      @default(dbgenerated("(quantity - reserved)"))
  updatedAt   DateTime @updatedAt @map("updated_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([variantId, warehouseId])
  @@index([warehouseId])
  @@map("inventory")
}

// ─── Pricing (§10) ───────────────────────────────────────────────────────────

/// Price lists: `retail` (seeded, default); wholesale / dealer / VIP are rows added later.
model PriceType {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(255)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prices Price[]

  @@map("price_types")
}

/// A variant's price in one price list and currency for a period (open-ended when null).
/// Effective selling price = `salePrice ?? price`; `oldPrice` is the crossed-out reference.
/// Choosing among overlapping periods is PricingService logic (latest `validFrom` wins).
model Price {
  id          String    @id @default(uuid(7)) @db.Uuid
  variantId   String    @map("variant_id") @db.Uuid
  priceTypeId String    @map("price_type_id") @db.Uuid
  /// ISO 4217, e.g. `UAH`.
  currency    String    @default("UAH") @db.Char(3)
  price       Decimal   @db.Decimal(12, 2)
  oldPrice    Decimal?  @map("old_price") @db.Decimal(12, 2)
  salePrice   Decimal?  @map("sale_price") @db.Decimal(12, 2)
  validFrom   DateTime? @map("valid_from")
  validTo     DateTime? @map("valid_to")
  externalId  String?   @unique @map("external_id") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceType PriceType      @relation(fields: [priceTypeId], references: [id], onDelete: Restrict)

  @@index([variantId, priceTypeId, currency, validFrom])
  @@map("prices")
}

// ─── Media (§16) ─────────────────────────────────────────────────────────────

/// A file in S3 (never in PostgreSQL). Stores the object key, not a URL: the public URL is
/// built from S3_PUBLIC_URL / CloudFront, so a CDN change needs no data migration.
/// AVIF/WebP renditions are produced by the `images` queue (step 10.5).
model Media {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// S3 object key, e.g. `products/2026/09/0192…-knife.jpg`.
  key       String   @unique @db.VarChar(500)
  /// Original upload name.
  filename  String   @db.VarChar(255)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  width     Int?
  height    Int?
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations MediaTranslation[]
  products     ProductMedia[]
  seoOgImages  SeoMetadata[]
  categories   Category[]         @relation("CategoryImage")
  brands       Brand[]            @relation("BrandLogo")

  @@map("media")
}

model MediaTranslation {
  mediaId String  @map("media_id") @db.Uuid
  locale  String  @db.VarChar(10)
  alt     String? @db.VarChar(500)
  title   String? @db.VarChar(255)

  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  language Locale @relation(fields: [locale], references: [code], onDelete: Restrict)

  @@id([mediaId, locale])
  @@map("media_translations")
}

/// Product gallery. At most one `isPrimary` per product (partial unique index in SQL).
/// `variantId` optionally ties an image to one variant (e.g. a colour).
model ProductMedia {
  productId String  @map("product_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  position  Int     @default(0)
  isPrimary Boolean @default(false) @map("is_primary")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media           @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@id([productId, mediaId])
  @@index([productId, position])
  @@index([mediaId])
  @@map("product_media")
}

// ─── SEO (§41, §43, §59) ─────────────────────────────────────────────────────

/// What a SEO record or redirect belongs to. ROUTE = a static storefront path (`/sale`, `/brands`).
enum SeoEntityType {
  PRODUCT
  CATEGORY
  BRAND
  PAGE
  ARTICLE
  ROUTE

  @@map("seo_entity_type")
}

/// The single source of SEO texts per entity and locale (no seo_* columns on entities).
/// Polymorphic: `entityId` is the entity UUID, or the path for ROUTE; the owning service deletes
/// these rows together with the entity. Missing fields fall back to generated templates.
model SeoMetadata {
  id            String        @id @default(uuid(7)) @db.Uuid
  entityType    SeoEntityType @map("entity_type")
  entityId      String        @map("entity_id") @db.VarChar(255)
  locale        String        @db.VarChar(10)
  title         String?       @db.VarChar(255)
  description   String?       @db.VarChar(500)
  /// Absolute or site-relative canonical override; default is the entity URL.
  canonical     String?       @db.VarChar(1000)
  noindex       Boolean       @default(false)
  nofollow      Boolean       @default(false)
  ogTitle       String?       @map("og_title") @db.VarChar(255)
  ogDescription String?       @map("og_description") @db.VarChar(500)
  ogImageId     String?       @map("og_image_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  language Locale @relation(fields: [locale], references: [code], onDelete: Restrict)
  ogImage  Media? @relation(fields: [ogImageId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, locale])
  @@map("seo_metadata")
}

enum RedirectSource {
  MANUAL
  /// Proposed automatically when a slug changes (§43).
  SLUG_CHANGE
  IMPORT

  @@map("redirect_source")
}

/// 301/302 redirects and 410 Gone for removed pages (§43, §14.2). Paths are site-relative,
/// normalized (leading `/`, no trailing `/`, no query). `toPath` is null only for 410.
/// The service rejects chains and loops when saving.
model Redirect {
  id         String         @id @default(uuid(7)) @db.Uuid
  fromPath   String         @unique @map("from_path") @db.VarChar(1000)
  toPath     String?        @map("to_path") @db.VarChar(1000)
  statusCode Int            @default(301) @map("status_code")
  source     RedirectSource @default(MANUAL)
  isActive   Boolean        @default(true) @map("is_active")
  hits       Int            @default(0)
  lastHitAt  DateTime?      @map("last_hit_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([toPath])
  @@map("redirects")
}

// ─── Integrations (§26–§30) ──────────────────────────────────────────────────

enum IntegrationEntityType {
  PRODUCT
  VARIANT
  CATEGORY
  BRAND
  WAREHOUSE
  PRICE_TYPE
  PRICE
  ATTRIBUTE
  ATTRIBUTE_VALUE
  ORDER
  CUSTOMER

  @@map("integration_entity_type")
}

/// External id ↔ internal id per integration (`tria`, supplier feeds). `payloadHash` of the last
/// applied payload lets a sync skip unchanged items and makes re-runs idempotent (§30).
model IntegrationMapping {
  id           String                @id @default(uuid(7)) @db.Uuid
  integration  String                @db.VarChar(50)
  entityType   IntegrationEntityType @map("entity_type")
  externalId   String                @map("external_id") @db.VarChar(255)
  internalId   String                @map("internal_id") @db.Uuid
  payloadHash  String?               @map("payload_hash") @db.VarChar(64)
  lastSyncedAt DateTime?             @map("last_synced_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@unique([integration, entityType, externalId])
  @@index([entityType, internalId])
  @@map("integration_mappings")
}

enum SyncTrigger {
  SCHEDULED
  MANUAL
  RETRY

  @@map("sync_trigger")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  /// Finished, but some items failed validation or mapping.
  PARTIAL
  FAILED

  @@map("sync_status")
}

/// One sync run (history for /admin/integrations, step 11.3). Item-level errors are a bounded
/// sample in `errors`; full details are in logs by `jobId`.
model SyncLog {
  id           String      @id @default(uuid(7)) @db.Uuid
  integration  String      @db.VarChar(50)
  /// What was synced: `products`, `prices`, `inventory`, `orders`.
  scope        String      @db.VarChar(50)
  trigger      SyncTrigger
  status       SyncStatus  @default(RUNNING)
  /// BullMQ job id, to correlate with logs.
  jobId        String?     @map("job_id") @db.VarChar(255)
  startedAt    DateTime    @default(now()) @map("started_at")
  finishedAt   DateTime?   @map("finished_at")
  itemsTotal   Int         @default(0) @map("items_total")
  itemsCreated Int         @default(0) @map("items_created")
  itemsUpdated Int         @default(0) @map("items_updated")
  itemsSkipped Int         @default(0) @map("items_skipped")
  itemsFailed  Int         @default(0) @map("items_failed")
  errorMessage String?     @map("error_message")
  /// Sample of item errors: [{ externalId, message }], capped by the sync service.
  errors       Json?

  @@index([integration, scope, startedAt(sort: Desc)])
  @@index([status])
  @@map("sync_logs")
}
